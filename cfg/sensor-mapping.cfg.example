# Sensor label mapping for the Phase 1 host panel.
#
# Key   = label used in the panel definition
# Value = label emitted by the sensor provider
#
# Rename to sensor-mapping.cfg to activate — asterctl loads that filename from
# --config-dir by default.
#
# WHY THIS FILE EXISTS
#
# aster-sysinfo names disk sensors after the block device it found them on, so
# the label differs on every machine:
#
#     disk_/dev/nvme0n1p2_usage_percent
#     disk_/dev/vda_usage_percent
#     disk_/dev/sda2_usage_percent
#
# The panel cannot hardcode that and stay portable, so it asks for a stable
# label and this file resolves it per host. Find the right device with:
#
#     aster-sysinfo --console | grep usage_percent
#
# then set the line below to match. Without it, ROOT DISK renders "--" —
# correctly, since the sensor it asked for genuinely does not exist.

disk_root_usage_percent: disk_/dev/mapper/pve-root_usage_percent

# Everything else the Phase 1 panel uses is already named consistently by
# aster-sysinfo and needs no mapping:
#   cpu_usage_percent  mem_usage_percent  load_avg_one
#   temperature_cpu    system_uptime      system_hostname

# ---------------------------------------------------------------------------
# Phase 2: Uptime-Kuma
#
# aster-prom uses the ENTIRE Prometheus metric line as the sensor key, labels
# included:
#
#     uptime_kuma_status{monitor_name="traefik",monitor_url="https://..."}
#
# That is unusable in a panel definition and would break silently if a monitor's
# URL changed in Kuma, so panels ask for stable names and this file resolves them.
#
# Kuma v2 dropped the uptime_kuma_ prefix for a bare monitor_ one. aster-prom
# does not care — it keys on whatever string the endpoint emits — so copy what
# YOUR instance prints, whichever dialect that is.
#
# NO _response ENTRIES. The panel used to show a latency column; it no longer
# does. Kuma's `docker` monitor type reports up/down and no response time at all,
# and most of these are docker monitors, so that column was mostly a permanent
# "--" occupying a third of the panel. Ten states in two columns is a better use
# of the glass than five states and five dashes.
#
# Get the exact keys from the live endpoint — copy them verbatim, including the
# braces, quotes and full URL:
#
#     aster-prom "http://localhost:3001/metrics" \
#         --password-file /etc/asterctl/kuma.key --console \
#         | grep -E 'opnsense|traefik|cloudflare|gluetun|haos|home|apprise|dockhand|n8n|diun'
#
# Then fill in the right-hand sides below. Any left unfilled render as "--",
# which is correct: the sensor genuinely does not exist.

# Left column — the path in, ordered outward from the firewall.
# kuma_opnsense_status:    monitor_status{monitor_name="opnsense",...}
# kuma_traefik_status:     monitor_status{monitor_name="traefik",...}
# kuma_cloudflare_status:  monitor_status{monitor_name="cloudflare",...}
# kuma_cloudflared_status: monitor_status{monitor_name="cloudflared",...}
# kuma_gluetun_status:     monitor_status{monitor_name="gluetun",...}

# Right column — silent failures, where nothing else would tell you.
# kuma_haos_status:        monitor_status{monitor_name="haos",...}
# kuma_apprise_status:     monitor_status{monitor_name="apprise",...}
# kuma_dockhand_status:    monitor_status{monitor_name="dockhand",...}
# kuma_n8n_status:         monitor_status{monitor_name="n8n",...}
# kuma_diun_status:        monitor_status{monitor_name="diun",...}

# TWO NAMES THAT LOOK ALIKE AND ARE NOT:
#   cloudflare   — a ping of 1.1.1.1, displayed as INTERNET
#   cloudflared  — the tunnel container, displayed as TUNNEL
# Likewise there may be more than one gluetun (e.g. gluetun and gluetun-us).
# Check the monitor_id label, not just the name.

# ---------------------------------------------------------------------------
# Phase 3: the homelab panel, fed by panel-metrics
#
# Most Phase 3 metrics need NO mapping. panel-metrics emits aggregates without
# Prometheus labels, so the metric name is already a usable sensor key:
#
#   homelab_problems_total   homelab_sources_down
#   truenas_pools_online     truenas_pools_total    truenas_uptime_days
#   kuma_monitors_up         kuma_monitors_total    kuma_cert_days_min
#
# That is the payoff from aggregating upstream — compare the ten lines Phase 2
# needs above to untangle one labelled metric.
#
# Only these two carry labels. Copy the right-hand sides verbatim from:
#
#     aster-prom "http://192.168.68.22:9101/metrics" --console \
#         | grep -E 'gateway_up|speedtest_tracker_download'

# opnsense_wan_gateway:    opnsense_gateway_up{gateway="WAN_GW"}
# hass_speedtest_download: hass_entity_state{entity="sensor.speedtest_tracker_download",unit="Mbit/s"}
